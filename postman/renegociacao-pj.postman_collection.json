            "body": { "mode": "raw", "raw": "{\n  \"habilitada\": true\n}" }
          }
        },
        {
          "name": "Mesma simulação na modernizada (não usa o cache do mainframe)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
