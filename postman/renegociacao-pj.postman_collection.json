                  "pm.test('Custódia SF', () => pm.expect(corpo.simulacao.custodia).to.eql('SF'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/v1/renegociacoes/simulacoes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cnpj\": \"{{cnpj}}\",\n  \"contratos\": [\n    { \"numeroContrato\": \"3001\", \"codigoProduto\": \"PJ01\" }\n  ]\n}"
