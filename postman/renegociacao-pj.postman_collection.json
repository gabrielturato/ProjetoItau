            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/v1/renegociacoes/simulacoes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cnpj\": \"{{cnpj}}\",\n  \"contratos\": [\n    { \"numeroContrato\": \"3001\", \"codigoProduto\": \"PJ01\" }\n  ]\n}"
            }
          }
        },
        {
          "name": "Trocar para modernizada",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
