                  "pm.test('Calculada pelo mainframe', () => pm.expect(corpo.simulacao.motorCalculo).to.eql('MAINFRAME'));",
                  "pm.test('Custódia F5', () => pm.expect(corpo.simulacao.custodia).to.eql('F5'));",
