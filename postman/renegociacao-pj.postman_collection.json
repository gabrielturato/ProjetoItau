            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/v1/renegociacoes/simulacoes",
            "body": { "mode": "raw", "raw": "{\n  \"cnpj\": \"{{cnpj}}\",\n  \"contratos\": []\n}" }
