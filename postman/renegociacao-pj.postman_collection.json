                  "pm.test('Jornada simulada', () => pm.expect(corpo.status).to.eql('SIMULADA'));",
                  "pm.test('Calculada pela modernizada (não veio do cache do mainframe)', () => pm.expect(corpo.simulacao.motorCalculo).to.eql('MODERNIZADA'));",
                  "pm.test('Custódia SF', () => pm.expect(corpo.simulacao.custodia).to.eql('SF'));",
