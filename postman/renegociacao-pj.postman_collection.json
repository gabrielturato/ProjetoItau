              "mode": "raw",
              "raw": "{\n  \"cnpj\": \"{{cnpj}}\",\n  \"contratos\": [\n    { \"numeroContrato\": \"3001\", \"codigoProduto\": \"PJ01\" }\n  ]\n}"
            }
          }
        }
      ]
    },
    {
      "name": "4. Cenários de erro",
      "item": [
        {
          "name": "CNPJ inválido → 422",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422 Unprocessable Entity', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/v1/renegociacoes/simulacoes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cnpj\": \"11.222.333/0001-82\",\n  \"contratos\": [\n    { \"numeroContrato\": \"1001\", \"codigoProduto\": \"PJ01\" }\n  ]\n}"
