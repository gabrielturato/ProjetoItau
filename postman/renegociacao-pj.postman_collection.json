    {
      "name": "3. Troca de calculadora (sem reaproveitar cache)",
      "description": "Mesma simulação, mesmo cliente, alternando a calculadora. Cada troca calcula pela calculadora ativa; voltar para a anterior reaproveita o cache dela.",
      "item": [
        {
          "name": "Selecionar mainframe",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/v1/admin/feature-flags/calculadora-modernizada",
            "body": { "mode": "raw", "raw": "{\n  \"habilitada\": false\n}" }
          }
        },
        {
          "name": "Simular no mainframe",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
